{
  "openapi": "3.0.3",
  "info": {
    "title": "Porskad REST API",
    "description": "Comprehensive developer REST API for Porskad — The intelligent online form, quiz, and survey builder. Integrate account details, complete form creation, all 20 question types, response submissions, and embed codes seamlessly into your own platform without exposing internal database credentials.",
    "version": "1.0.0",
    "contact": {
      "name": "Porskad Developer Support",
      "url": "https://porskad.ir"
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "Current Server Origin"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Account",
      "description": "User profile, quotas, subscription, and account limits"
    },
    {
      "name": "Question Types",
      "description": "Metadata, validation rules, and schema definitions for all 20 question types"
    },
    {
      "name": "Forms",
      "description": "Complete CRUD operations for managing forms"
    },
    {
      "name": "Questions",
      "description": "Manage form questions, options, conditional logic, and ordering"
    },
    {
      "name": "Responses",
      "description": "Query and manage participant responses and submissions"
    },
    {
      "name": "Submission",
      "description": "Submit form answers programmatically from external websites and mobile apps"
    },
    {
      "name": "Embed",
      "description": "Ready-to-use Iframe, SDK script, React component, and direct URLs"
    }
  ],
  "paths": {
    "/api/v1/me": {
      "get": {
        "tags": ["Account"],
        "summary": "Get current user profile and quota",
        "description": "Retrieves the authenticated user's profile, role, forms count, and subscription limits.",
        "responses": {
          "200": {
            "description": "User profile retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfile"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/api/v1/question-types": {
      "get": {
        "tags": ["Question Types"],
        "summary": "List all 20 supported question types",
        "description": "Returns full metadata, categories, valid options, default values, and condition operators for all 20 question types supported in Porskad.",
        "security": [],
        "responses": {
          "200": {
            "description": "Question types metadata retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": { "type": "integer", "example": 20 },
                    "categories": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/QuestionCategory" }
                    },
                    "types": {
                      "type": "object",
                      "additionalProperties": { "$ref": "#/components/schemas/QuestionTypeMeta" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/forms": {
      "get": {
        "tags": ["Forms"],
        "summary": "List user forms",
        "description": "Returns a paginated list of all active forms owned by the authenticated user, along with response counts and public URLs.",
        "parameters": [
          {
            "name": "published",
            "in": "query",
            "required": false,
            "description": "Filter by published status (true or false)",
            "schema": { "type": "boolean" }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Max number of items to return (default: 50)",
            "schema": { "type": "integer", "default": 50 }
          }
        ],
        "responses": {
          "200": {
            "description": "List of forms retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": { "type": "integer", "example": 5 },
                    "forms": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/FormSummary" }
                    }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/UnauthorizedError" }
        }
      },
      "post": {
        "tags": ["Forms"],
        "summary": "Create a new form",
        "description": "Creates a new form with custom settings, slug, display mode (step-by-step or classic), and welcome/exit screens.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateFormInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Form created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "form": { "$ref": "#/components/schemas/FormDetail" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequestError" },
          "401": { "$ref": "#/components/responses/UnauthorizedError" }
        }
      }
    },
    "/api/v1/forms/{id}": {
      "get": {
        "tags": ["Forms"],
        "summary": "Get form details with questions",
        "description": "Fetches a single form by its UUID or unique slug, including its full ordered list of questions and settings.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Form UUID or unique slug",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Form details and questions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "form": { "$ref": "#/components/schemas/FormDetail" },
                    "questions": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/QuestionDetail" }
                    }
                  }
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFoundError" }
        }
      },
      "put": {
        "tags": ["Forms"],
        "summary": "Update form settings",
        "description": "Updates form title, description, published status, themes, and welcome/exit screens.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Form UUID or unique slug",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateFormInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Form updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "form": { "$ref": "#/components/schemas/FormDetail" }
                  }
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFoundError" }
        }
      },
      "delete": {
        "tags": ["Forms"],
        "summary": "Delete a form",
        "description": "Permanently deletes a form and its questions.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Form UUID or unique slug",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Form deleted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": { "type": "string", "example": "Form and its questions were deleted successfully." }
                  }
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFoundError" }
        }
      }
    },
    "/api/v1/forms/{id}/questions": {
      "get": {
        "tags": ["Questions"],
        "summary": "List all questions in a form",
        "description": "Returns all questions belonging to the specified form, sorted by their position index.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Form UUID or slug",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "List of questions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": { "type": "integer", "example": 6 },
                    "questions": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/QuestionDetail" }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Questions"],
        "summary": "Add a new question to form",
        "description": "Adds a question to the form using any of the 20 supported types.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Form UUID or slug",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateQuestionInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Question added successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "question": { "$ref": "#/components/schemas/QuestionDetail" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/forms/{id}/questions/{questionId}": {
      "put": {
        "tags": ["Questions"],
        "summary": "Update an existing question",
        "description": "Updates question title, options, required flag, display mode, or conditions.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Form UUID or slug",
            "schema": { "type": "string" }
          },
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "description": "Question UUID",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateQuestionInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Question updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "question": { "$ref": "#/components/schemas/QuestionDetail" }
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Questions"],
        "summary": "Delete a question",
        "description": "Removes a question from the form.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Form UUID or slug",
            "schema": { "type": "string" }
          },
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "description": "Question UUID",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Question deleted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/forms/{id}/responses": {
      "get": {
        "tags": ["Responses"],
        "summary": "List submitted responses",
        "description": "Retrieves submitted responses and answers for this form, with device metadata, browser, and duration.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Form UUID or slug",
            "schema": { "type": "string" }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Pagination limit (default: 50, max: 200)",
            "schema": { "type": "integer", "default": 50 }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 0 }
          }
        ],
        "responses": {
          "200": {
            "description": "Responses retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "form_id": { "type": "string" },
                    "total": { "type": "integer", "example": 25 },
                    "responses": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/ResponseDetail" }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Submission"],
        "summary": "Submit answers to a form",
        "description": "Submits answers from an external platform or client application directly without loading the Porskad web interface.",
        "security": [],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Form UUID or unique slug",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SubmitResponseInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Response submitted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "response_id": { "type": "string", "example": "4a58b5e2-632b-4221-8255-a0c3bbd4a2d7" },
                    "message": { "type": "string", "example": "Thank you for your feedback!" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/forms/{id}/responses/{responseId}": {
      "delete": {
        "tags": ["Responses"],
        "summary": "Delete a response submission",
        "description": "Deletes a specific submission and all its associated answers.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Form UUID or slug",
            "schema": { "type": "string" }
          },
          {
            "name": "responseId",
            "in": "path",
            "required": true,
            "description": "Response UUID",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Response deleted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/forms/{id}/embed": {
      "get": {
        "tags": ["Embed"],
        "summary": "Get embed codes and direct links",
        "description": "Generates ready-to-use Iframe code, JavaScript SDK snippet, React component code, and direct URLs.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Form UUID or slug",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Embed snippets generated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EmbedCodes" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Enter your Porskad user session JWT token. Format: `Bearer <token>`"
      }
    },
    "schemas": {
      "UserProfile": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "email": { "type": "string", "example": "user@example.com" },
          "full_name": { "type": "string", "example": "Alex Doe" },
          "role": { "type": "string", "example": "manager" },
          "is_owner": { "type": "boolean", "example": false },
          "phone": { "type": "string", "example": "+1234567890" },
          "forms_count": { "type": "integer", "example": 4 },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "QuestionCategory": {
        "type": "object",
        "properties": {
          "key": { "type": "string", "example": "choice" },
          "title": { "type": "string", "example": "Choice & Rating Questions" },
          "description": { "type": "string", "example": "Multiple choice, dropdowns, scales, and ratings" },
          "types": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "QuestionTypeMeta": {
        "type": "object",
        "properties": {
          "label": { "type": "string", "example": "Multiple Choice" },
          "category": { "type": "string", "example": "choice" },
          "hint": { "type": "string", "example": "Select 1 to N choices" },
          "hasOptions": { "type": "boolean", "example": true },
          "hasMaxSelections": { "type": "boolean", "example": true },
          "hasDisplayMode": { "type": "boolean", "example": true },
          "defaultDisplayMode": { "type": "string", "example": "buttons" },
          "defaultOptions": { "type": "array", "items": { "type": "string" } },
          "conditionOperators": { "type": "array", "items": { "type": "string" } }
        }
      },
      "FormSummary": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "slug": { "type": "string", "example": "customer-satisfaction-2026" },
          "title": { "type": "string", "example": "Customer Satisfaction Survey" },
          "form_type": { "type": "string", "example": "step_by_step" },
          "published": { "type": "boolean", "example": true },
          "public_url": { "type": "string", "example": "https://porskad.ir/f/customer-satisfaction-2026" },
          "embed_url": { "type": "string", "example": "https://porskad.ir/embed/customer-satisfaction-2026" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "CreateFormInput": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": { "type": "string", "example": "Product Feedback Form" },
          "slug": { "type": "string", "example": "product-feedback", "description": "Unique slug (lowercase alphanumeric and hyphens)" },
          "form_type": { "type": "string", "enum": ["step_by_step", "classic"], "default": "step_by_step" },
          "description": { "type": "string", "example": "Tell us what you think of our new release." },
          "welcome_title": { "type": "string", "example": "Welcome!" },
          "welcome_message": { "type": "string", "example": "This survey takes about 2 minutes." },
          "exit_title": { "type": "string", "example": "Done!" },
          "exit_message": { "type": "string", "example": "Thank you for taking the time to answer." },
          "default_theme": { "type": "string", "enum": ["light", "dark", "system"], "default": "light" }
        }
      },
      "UpdateFormInput": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "description": { "type": "string" },
          "published": { "type": "boolean" },
          "welcome_title": { "type": "string" },
          "welcome_message": { "type": "string" },
          "exit_title": { "type": "string" },
          "exit_message": { "type": "string" },
          "default_theme": { "type": "string" }
        }
      },
      "FormDetail": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "slug": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "form_type": { "type": "string" },
          "published": { "type": "boolean" },
          "welcome_title": { "type": "string" },
          "welcome_message": { "type": "string" },
          "exit_title": { "type": "string" },
          "exit_message": { "type": "string" },
          "default_theme": { "type": "string" },
          "created_at": { "type": "string" },
          "updated_at": { "type": "string" }
        }
      },
      "CreateQuestionInput": {
        "type": "object",
        "required": ["type", "title"],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "choice", "picture_choice", "dropdown", "yes_no", "likert", "nps", "rating", "matrix", "ranking",
              "short_text", "long_text", "number", "email", "phone_ir", "link", "telegram_id",
              "statement", "group", "file_upload", "payment"
            ],
            "example": "choice"
          },
          "title": { "type": "string", "example": "How would you rate our delivery speed?" },
          "description": { "type": "string", "example": "Select one or more options." },
          "required": { "type": "boolean", "default": true },
          "options": {
            "type": "array",
            "items": { "type": "string" },
            "example": ["Fast", "Acceptable", "Slow"]
          },
          "position": { "type": "integer", "default": 0 },
          "display_mode": { "type": "string", "enum": ["buttons", "list", "grid"], "default": "buttons" },
          "max_selections": { "type": "integer", "example": 1 },
          "points": { "type": "number", "example": 10 },
          "correct_answer": { "type": "string" },
          "conditions": { "type": "object" }
        }
      },
      "QuestionDetail": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "form_id": { "type": "string", "format": "uuid" },
          "type": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "required": { "type": "boolean" },
          "options": { "type": "array" },
          "position": { "type": "integer" },
          "display_mode": { "type": "string" },
          "max_selections": { "type": "integer" },
          "points": { "type": "number" },
          "correct_answer": { "type": "string" },
          "conditions": { "type": "object" }
        }
      },
      "SubmitAnswerItem": {
        "type": "object",
        "required": ["question_id", "value"],
        "properties": {
          "question_id": { "type": "string", "format": "uuid" },
          "value": {
            "description": "User answer (string, number, array of options, or object)",
            "example": ["Fast"]
          },
          "time_spent_seconds": { "type": "integer", "example": 5 }
        }
      },
      "SubmitResponseInput": {
        "type": "object",
        "required": ["answers"],
        "properties": {
          "answers": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/SubmitAnswerItem" }
          },
          "duration_seconds": { "type": "integer", "example": 35 },
          "device": { "type": "string", "example": "mobile" },
          "browser": { "type": "string", "example": "Chrome" }
        }
      },
      "ResponseDetail": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "form_id": { "type": "string", "format": "uuid" },
          "is_complete": { "type": "boolean" },
          "started_at": { "type": "string" },
          "submitted_at": { "type": "string" },
          "duration_seconds": { "type": "integer" },
          "device": { "type": "string" },
          "browser": { "type": "string" },
          "answers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "question_id": { "type": "string" },
                "value": {}
              }
            }
          }
        }
      },
      "EmbedCodes": {
        "type": "object",
        "properties": {
          "form_id": { "type": "string" },
          "slug": { "type": "string" },
          "direct_url": { "type": "string", "example": "https://porskad.ir/f/my-form" },
          "embed_url": { "type": "string", "example": "https://porskad.ir/embed/my-form" },
          "iframe_code": {
