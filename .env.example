# ── تنظیمات Supabase ──
# بعد از ساخت پروژه در supabase.com این دو مقدار را از:
#   Project Settings → API
# کپی کنید و فایل را با نام .env ذخیره کنید.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ── تنظیمات آموت (SMS) ──
# توکن وب‌سرویس آموت — از پنل آموت → وب‌سرویس
AMOOT_TOKEN=your-amoot-token
# امضای وب‌هوک آموت — از پنل آموت → تنظیمات وب‌هوک
AMOOT_WEBHOOK_SECRET=your-amoot-webhook-signature
